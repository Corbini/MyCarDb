root = true

# -------------------
# All Files
# -------------------
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# -------------------
# C# Files
# -------------------
[*.cs]

# - Formatting ----
csharp_new_line_before_open_brace = all
csharp_indent_labels = flush_left
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# - var Usage ----
csharp_style_var_for_built_in_types = false
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true
dotnet_diagnostic.IDE0007.severity = warning   # use 'var'
dotnet_diagnostic.IDE0008.severity = warning   # use explicit type

# - Expression-Bodied Members ----
csharp_style_expression_bodied_methods = when_on_single_line
csharp_style_expression_bodied_properties = true
dotnet_diagnostic.IDE0022.severity = suggestion
dotnet_diagnostic.IDE0025.severity = suggestion

# - Pattern Matching & Null Checking ----
csharp_style_prefer_pattern_matching = true
csharp_style_prefer_null_check_over_type_check = true
dotnet_style_null_propagation = true
dotnet_style_prefer_is_null_check_over_reference_equality_method = true
dotnet_style_coalesce_expression = true
dotnet_diagnostic.IDE0078.severity = warning   # pattern matching
dotnet_diagnostic.IDE0150.severity = warning   # null check over type check
dotnet_diagnostic.IDE0031.severity = warning   # null propagation
dotnet_diagnostic.IDE0041.severity = warning   # 'is null' over ReferenceEquals
dotnet_diagnostic.IDE0029.severity = warning   # coalesce expression
dotnet_diagnostic.IDE0030.severity = warning   # coalesce expression (nullable)

# - Using Directives ----
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# - Namespace Style ----
csharp_style_namespace_declarations = file_scoped
dotnet_diagnostic.IDE0161.severity = warning   # file-scoped namespace

# - Primary Constructors ----
csharp_style_prefer_primary_constructor = true
dotnet_diagnostic.IDE0290.severity = suggestion

# - Braces ----
csharp_prefer_braces = when_multiline
dotnet_diagnostic.IDE0011.severity = suggestion

# - Diagnostic Promotions (caught in CI via -warnaserror) ----
dotnet_diagnostic.IDE0044.severity = warning   # add readonly modifier
dotnet_diagnostic.IDE0051.severity = warning   # unused private member
dotnet_diagnostic.IDE0052.severity = warning   # unread private member
dotnet_diagnostic.IDE0060.severity = warning   # unused parameter

# -------------------------
# Naming Conventions
# -------------------------
# PascalCase for types/members and camelCase for parameters/locals are C#
# language defaults — not redeclared here. Type parameter `T` prefix and
# async `Async` suffix are covered by CA1715 / VSTHRD200 if those analyzers
# are added.

# Private fields - _camelCase
dotnet_naming_rule.private_fields_should_be_camel_case.symbols = private_fields_symbols
dotnet_naming_rule.private_fields_should_be_camel_case.style = underscore_camel_style
dotnet_naming_rule.private_fields_should_be_camel_case.severity = warning

dotnet_naming_symbols.private_fields_symbols.applicable_kinds = field
dotnet_naming_symbols.private_fields_symbols.applicable_accessibilities = private

dotnet_naming_style.underscore_camel_style.required_prefix = _
dotnet_naming_style.underscore_camel_style.capitalization = camel_case

# Interfaces - IPascalCase
dotnet_naming_rule.interfaces_should_be_prefixed.symbols = interface_symbols
dotnet_naming_rule.interfaces_should_be_prefixed.style = i_prefix_pascal_style
dotnet_naming_rule.interfaces_should_be_prefixed.severity = warning

dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.interface_symbols.applicable_accessibilities = *

dotnet_naming_style.i_prefix_pascal_style.required_prefix = I
dotnet_naming_style.i_prefix_pascal_style.capitalization = pascal_case

# -------------------------
# JSON / YAML / Config Files
# -------------------------
[*.{json,yaml,yml,config}]
indent_size = 2

# -------------------------
# Markdown & Docs
# -------------------------
[*.{md,mdx}]
trim_trailing_whitespace = false
indent_size = 2

# -------------------------
# Avalonia XAML
# -------------------------
[*.{axaml,xaml}]
max_line_length = 160

# - Avalonia XAML Diagnostics ----
avalonia_xaml_diagnostic.AVLN2203.severity = warning      # DuplicateSetterError
avalonia_xaml_diagnostic.AVLN2204.severity = warning      # StyleInMergedDictionaries
avalonia_xaml_diagnostic.AVLN2205.severity = warning      # RequiredTemplatePartMissing
avalonia_xaml_diagnostic.AVLN2206.severity = suggestion   # OptionalTemplatePartMissing
avalonia_xaml_diagnostic.AVLN2207.severity = warning      # TemplatePartWrongType
avalonia_xaml_diagnostic.AVLN2208.severity = warning      # ItemContainerInsideTemplate
avalonia_xaml_diagnostic.AVLN5001.severity = warning      # Obsolete API usage

# -------------------------
# .NET Project / Resource Files
# -------------------------
[*.{csproj,slnx,resx,xml}]
indent_size = 2

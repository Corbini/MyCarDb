<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="using:MyCarDbView.MVVM"
             x:Class="MyCarDbView.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaStyles/AppStyle.axaml"/>
    </Application.Styles>
    <Application.DataTemplates>
        <mvvm:ViewLocator/>
    </Application.DataTemplates>
</Application>

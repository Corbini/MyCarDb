<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyCarDbView.ViewModels"
             xmlns:localization="using:MyCarDbView.Localizations"
             mc:Ignorable="d"
             d:DesignWidth="760" d:DesignHeight="640"
             x:Class="MyCarDbView.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             FontFamily="Inter, Segoe UI Variable Text, Segoe UI"
             FontSize="13"
             Width="760"
             MaxHeight="640">

    <UserControl.Styles>
        <Style Selector="Border.kbd-chip">
            <Setter Property="Background" Value="{DynamicResource BorderStrong}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="sheet" ClipToBounds="True">
        <Grid RowDefinitions="52,*">

            <Border Grid.Row="0" Classes="chrome">
                <Grid ColumnDefinitions="*,Auto,*" Margin="14,0">
                    <TextBlock Grid.Column="1"
                               Classes="callout"
                               FontWeight="SemiBold"
                               Text="{localization:View Settings_Title}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="2"
                            Classes="plain"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Right"
                            Content="{localization:View Settings_Done}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="200,*">

                <Border Grid.Column="0"
                        Classes="divider-right"
                        Background="{DynamicResource BgSidebar}">
                    <StackPanel Margin="8,12">
                        <Button Classes="borderless"
                                Classes.selected="{Binding IsGeneralSelected}"
                                Command="{Binding SelectCategoryCommand}"
                                CommandParameter="{x:Static vm:SettingsCategory.General}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand"
                                Margin="0,1"
                                Padding="12,6"
                                Content="{localization:View Settings_Category_General}"/>
                        <Button Classes="borderless"
                                Classes.selected="{Binding IsShortcutsSelected}"
                                Command="{Binding SelectCategoryCommand}"
                                CommandParameter="{x:Static vm:SettingsCategory.Shortcuts}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand"
                                Margin="0,1"
                                Padding="12,6"
                                Content="{localization:View Settings_Category_Shortcuts}"/>

                        <Border Height="1"
                                Background="{DynamicResource Border}"
                                Margin="12,8"/>

                        <Button Classes="borderless"
                                Classes.selected="{Binding IsAboutSelected}"
                                Command="{Binding SelectCategoryCommand}"
                                CommandParameter="{x:Static vm:SettingsCategory.About}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand"
                                Margin="0,1"
                                Padding="12,6"
                                Content="{localization:View Settings_Category_About}"/>
                        <Button Classes="borderless"
                                Classes.selected="{Binding IsLicensesSelected}"
                                Command="{Binding SelectCategoryCommand}"
                                CommandParameter="{x:Static vm:SettingsCategory.Licenses}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand"
                                Margin="0,1"
                                Padding="12,6"
                                Content="{localization:View Settings_Category_Licenses}"/>
                    </StackPanel>
                </Border>

                <Panel Grid.Column="1" Background="{DynamicResource BgContent}">

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding IsGeneralSelected}">
                        <StackPanel Margin="24,20">

                            <StackPanel Spacing="12">
                                <TextBlock Classes="section-header" Text="{localization:View Settings_Appearance_Header}"/>
                                <Grid ColumnDefinitions="140,*"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="16">
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Classes="body"
                                               Text="{localization:View Settings_Appearance_Theme_Label}"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Classes="segmented-control"
                                            HorizontalAlignment="Left">
                                        <UniformGrid Rows="1" Columns="3" Width="280">
                                            <Button Classes="segment active" Content="{localization:View Settings_Appearance_Theme_Auto}"/>
                                            <Button Classes="segment" Content="{localization:View Settings_Appearance_Theme_Light}"/>
                                            <Button Classes="segment" Content="{localization:View Settings_Appearance_Theme_Dark}"/>
                                        </UniformGrid>
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Classes="caption"
                                               Text="{localization:View Settings_Appearance_Theme_Caption}"
                                               Margin="0,4,0,0"/>
                                </Grid>
                            </StackPanel>

                            <Border Classes="divider-top" Margin="0,24,0,0" Padding="0,24,0,0">
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="section-header" Text="{localization:View Settings_Language_Header}"/>
                                    <Grid ColumnDefinitions="140,*" ColumnSpacing="16">
                                        <TextBlock Grid.Column="0"
                                                   Classes="body"
                                                   Text="{localization:View Settings_Language_Label}"
                                                   VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1"
                                                  SelectedIndex="0"
                                                  HorizontalAlignment="Left"
                                                  MinWidth="200"
                                                  MaxWidth="200">
                                            <ComboBoxItem Content="{localization:View Settings_Language_Polish}"/>
                                            <ComboBoxItem Content="{localization:View Settings_Language_English}"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="divider-top" Margin="0,24,0,0" Padding="0,24,0,0">
                                <StackPanel Spacing="14">
                                    <TextBlock Classes="section-header" Text="{localization:View Settings_Save_Header}"/>

                                    <Grid ColumnDefinitions="140,*,Auto"
                                          RowDefinitions="Auto,Auto"
                                          ColumnSpacing="16">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Classes="body"
                                                   Text="{localization:View Settings_Save_AutoBackup_Label}"
                                                   VerticalAlignment="Center"/>
                                        <ToggleSwitch Grid.Row="0" Grid.Column="2"
                                                      IsChecked="True"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                   Classes="caption"
                                                   Text="{localization:View Settings_Save_AutoBackup_Description}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="140,*,Auto"
                                          RowDefinitions="Auto,Auto"
                                          ColumnSpacing="16">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Classes="body"
                                                   Text="{localization:View Settings_Save_FileMonitor_Label}"
                                                   VerticalAlignment="Center"/>
                                        <ToggleSwitch Grid.Row="0" Grid.Column="2"
                                                      IsChecked="True"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                   Classes="caption"
                                                   Text="{localization:View Settings_Save_FileMonitor_Description}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding IsShortcutsSelected}">
                        <Grid Margin="24,20" ColumnDefinitions="*,Auto" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"  Grid.Column="0" Classes="body" Text="{localization:View Settings_Shortcuts_Search}"/>
                            <Border    Grid.Row="0"  Grid.Column="1" Classes="kbd-chip"><TextBlock Classes="mono kbd-hint" Text="Ctrl+F"/></Border>

                            <TextBlock Grid.Row="1"  Grid.Column="0" Classes="body" Text="{localization:View Settings_Shortcuts_OpenSave}"/>
                            <Border    Grid.Row="1"  Grid.Column="1" Classes="kbd-chip"><TextBlock Classes="mono kbd-hint" Text="Ctrl+O"/></Border>

                            <TextBlock Grid.Row="2"  Grid.Column="0" Classes="body" Text="{localization:View Settings_Shortcuts_Save}"/>
                            <Border    Grid.Row="2"  Grid.Column="1" Classes="kbd-chip"><TextBlock Classes="mono kbd-hint" Text="Ctrl+S"/></Border>

                            <TextBlock Grid.Row="3"  Grid.Column="0" Classes="body" Text="{localization:View Settings_Shortcuts_UndoRedo}"/>
                            <Border    Grid.Row="3"  Grid.Column="1" Classes="kbd-chip"><TextBlock Classes="mono kbd-hint" Text="Ctrl+Z / Ctrl+Y"/></Border>

                            <TextBlock Grid.Row="4"  Grid.Column="0" Classes="body" Text="{localization:View Settings_Shortcuts_SheetReload}"/>
                            <Border    Grid.Row="4"  Grid.Column="1" Classes="kbd-chip"><TextBlock Classes="mono kbd-hint" Text="Ctrl+R"/></Border>

                            <TextBlock Grid.Row="5"  Grid.Column="0" Classes="body" Text="{localization:View Settings_Shortcuts_SatsumaFullView}"/>
                            <Border    Grid.Row="5"  Grid.Column="1" Classes="kbd-chip"><TextBlock Classes="mono kbd-hint" Text="Ctrl+E"/></Border>

                            <TextBlock Grid.Row="6"  Grid.Column="0" Classes="body" Text="{localization:View Settings_Shortcuts_ToggleSidebar}"/>
                            <Border    Grid.Row="6"  Grid.Column="1" Classes="kbd-chip"><TextBlock Classes="mono kbd-hint" Text="Ctrl+Alt+S"/></Border>

                            <TextBlock Grid.Row="7"  Grid.Column="0" Classes="body" Text="{localization:View Settings_Shortcuts_ToggleInspector}"/>
                            <Border    Grid.Row="7"  Grid.Column="1" Classes="kbd-chip"><TextBlock Classes="mono kbd-hint" Text="Ctrl+Alt+I"/></Border>

                            <TextBlock Grid.Row="8"  Grid.Column="0" Classes="body" Text="{localization:View Settings_Shortcuts_CenterPlayer}"/>
                            <Border    Grid.Row="8"  Grid.Column="1" Classes="kbd-chip"><TextBlock Classes="mono kbd-hint" Text="Ctrl+L"/></Border>

                            <TextBlock Grid.Row="9"  Grid.Column="0" Classes="body" Text="{localization:View Settings_Shortcuts_MapZoom}"/>
                            <Border    Grid.Row="9"  Grid.Column="1" Classes="kbd-chip"><TextBlock Classes="mono kbd-hint" Text="Ctrl++ / Ctrl+-"/></Border>

                            <TextBlock Grid.Row="10" Grid.Column="0" Classes="body" Text="{localization:View Settings_Shortcuts_ResetZoom}"/>
                            <Border    Grid.Row="10" Grid.Column="1" Classes="kbd-chip"><TextBlock Classes="mono kbd-hint" Text="Ctrl+0"/></Border>

                            <TextBlock Grid.Row="11" Grid.Column="0" Classes="body" Text="{localization:View Settings_Shortcuts_OpenSettings}"/>
                            <Border    Grid.Row="11" Grid.Column="1" Classes="kbd-chip"><TextBlock Classes="mono kbd-hint" Text="Ctrl+,"/></Border>

                            <TextBlock Grid.Row="12" Grid.Column="0" Classes="body" Text="{localization:View Settings_Shortcuts_DismissSheet}"/>
                            <Border    Grid.Row="12" Grid.Column="1" Classes="kbd-chip"><TextBlock Classes="mono kbd-hint" Text="Esc"/></Border>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding IsAboutSelected}">
                        <StackPanel Margin="24,40" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Classes="display"
                                       Text="MyCarDb"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Classes="callout secondary"
                                       Text="{localization:View Settings_About_Tagline}"
                                       HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        HorizontalAlignment="Center"
                                        Margin="0,16,0,0">
                                <TextBlock Classes="caption"
                                           Text="{localization:View Settings_About_Version_Label}"/>
                                <TextBlock Classes="caption"
                                           Text="0.1.0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding IsLicensesSelected}">
                        <StackPanel Margin="24,20" Spacing="12">
                            <TextBlock Classes="body"
                                       Text="{localization:View Settings_Licenses_Intro}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>

                </Panel>
            </Grid>
        </Grid>
    </Border>
</UserControl>

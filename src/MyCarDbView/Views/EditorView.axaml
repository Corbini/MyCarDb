<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyCarDbView.ViewModels"
             xmlns:views="using:MyCarDbView.Views"
             xmlns:localization="using:MyCarDbView.Localizations"
             xmlns:appstate="using:MyCarDbView.Models.AppState"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="MyCarDbView.Views.EditorView"
             x:DataType="vm:EditorViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveFileCommand}"/>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileDialogCommand}"/>
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}"/>
        <KeyBinding Gesture="Ctrl+Alt+S" Command="{Binding ToggleSidebarCommand}"/>
        <KeyBinding Gesture="Ctrl+Alt+I" Command="{Binding ToggleInspectorCommand}"/>
    </UserControl.KeyBindings>

    <views:EditorView.TitleBarLeading>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="bordered icon"
                    Classes.active="{Binding IsSidebarVisible}"
                    Command="{Binding ToggleSidebarCommand}"
                    ToolTip.Tip="{localization:View Sidebar_Toggle_Tooltip}">
                <Icon Symbol="sidebar-left" Classes="size-base"/>
            </Button>
            <TextBlock Classes="subhead"
                    Text="{Binding FileName}"
                    VerticalAlignment="Center"
                    Margin="14,0,0,0"/>
        </StackPanel>
    </views:EditorView.TitleBarLeading>

    <views:EditorView.TitleBarTrailing>
        <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="bordered icon"
                    ToolTip.Tip="{localization:View Editor_OpenFile_Tooltip}"
                    Command="{Binding OpenFileDialogCommand}">
                <Icon Symbol="folder-open" Classes="size-base"/>
            </Button>
            <Button Classes="bordered filled"
                    Command="{Binding SaveFileCommand}"
                    ToolTip.Tip="{localization:View Editor_Save_Tooltip}"
                    Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Icon Symbol="floppy-disk" Classes="size-base"/>
                    <TextBlock Text="{localization:View Editor_Save_Label}" />
                </StackPanel>
            </Button>
            <Button Classes="bordered icon"
                    ToolTip.Tip="{localization:View Editor_CarDetails_Tooltip}">
                <Icon Symbol="car" Classes="size-base"/>
            </Button>
            <Button Classes="bordered icon"
                    Classes.active="{Binding IsInspectorVisible}"
                    Command="{Binding ToggleInspectorCommand}"
                    ToolTip.Tip="{localization:View Editor_Inspector_Toggle_Tooltip}">
                <Icon Symbol="sidebar-right" Classes="size-base"/>
            </Button>
        </StackPanel>
    </views:EditorView.TitleBarTrailing>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" MinWidth="244" MaxWidth="400"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*" MinWidth="244"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="244" MinWidth="244" MaxWidth="400"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                Grid.ColumnSpan="2"
                IsVisible="{Binding IsSidebarVisible}"
                Classes="divider-right"
                Background="{DynamicResource BgSidebar}">
            <DockPanel>
                <Border DockPanel.Dock="Bottom"
                        Classes="divider-top"
                        Padding="8,6">
                    <Button Classes="borderless icon small"
                            HorizontalAlignment="Left"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="{localization:View Welcome_Settings_Tooltip}">
                        <Icon Symbol="settings" Classes="size-base"/>
                    </Button>
                </Border>

                <views:EntityBrowserView DataContext="{Binding EntityBrowser}"/>
            </DockPanel>
        </Border>
        <GridSplitter Grid.Column="1"
                      Background="Transparent"
                      IsVisible="{Binding IsSidebarVisible}"/>
        <views:MapView Grid.Column="2"
                        DataContext="{Binding Map}"/>
        <Border Grid.Column="3"
                Grid.ColumnSpan="2"
                IsVisible="{Binding IsInspectorVisible}"
                Classes="divider-left"
                Background="{DynamicResource BgSidebar}">
            <views:InspectorView DataContext="{Binding Inspector}"/>
        </Border>
        <GridSplitter Grid.Column="3"
                      Background="Transparent"
                      IsVisible="{Binding IsInspectorVisible}"/>
</Grid>
</UserControl>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BgWindow"    Color="#1E1E1E"/>
    <SolidColorBrush x:Key="BgChrome"    Color="#C7282828"/>
    <SolidColorBrush x:Key="BgSidebar"   Color="#99242424"/>
    <SolidColorBrush x:Key="BgInspector" Color="#C7282828"/>
    <SolidColorBrush x:Key="BgContent"   Color="#2A2A2A"/>
    <SolidColorBrush x:Key="BgRowHover"  Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="BgRowSelectedStrong" Color="#0A84FF"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="Border"       Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#24FFFFFF"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Text"            Color="#F5F5F7"/>
    <SolidColorBrush x:Key="TextSecondary"   Color="#99EBEBF5"/>
    <SolidColorBrush x:Key="TextTertiary"    Color="#52EBEBF5"/>
    <SolidColorBrush x:Key="TextQuaternary"  Color="#2EEBEBF5"/>

    <!-- States / Accents -->
    <SolidColorBrush x:Key="Accent"      Color="#0A84FF"/>
    <SolidColorBrush x:Key="AccentFill"  Color="#2E0A84FF"/>
    <SolidColorBrush x:Key="Warn"        Color="#FF9F0A"/>
    <SolidColorBrush x:Key="WarnFill"    Color="#2EFF9F0A"/>
    <SolidColorBrush x:Key="Danger"      Color="#FF453A"/>
    <SolidColorBrush x:Key="DangerFill"  Color="#2EFF453A"/>
    <SolidColorBrush x:Key="Success"     Color="#30D158"/>
    <SolidColorBrush x:Key="SuccessFill" Color="#2E30D158"/>

    <!-- Text on accent backgrounds (filled buttons) -->
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextOnWarn"   Color="#1D1D1F"/>

    <!-- Modal backdrop -->
    <SolidColorBrush x:Key="Backdrop"    Color="#99000000"/>

</ResourceDictionary>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Icons\*.svg" />
    <AdditionalFiles Include="Map\*.svg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvaloniaStyles.Generators\AvaloniaStyles.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      UndefineProperties="TargetFramework;RuntimeIdentifier;SelfContained;PublishTrimmed;PublishReadyToRun;PublishAot" />
  </ItemGroup>

</Project>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>

        <ControlTheme x:Key="{x:Type Icon}" TargetType="Icon">

            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>

            <Setter Property="Template">
                <ControlTemplate TargetType="Icon">
                    <Viewbox Width="{TemplateBinding Width}"
                             Height="{TemplateBinding Height}"
                             Stretch="Uniform">
                        <Canvas Width="256" Height="256">
                            <Path Data="{TemplateBinding Data}"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="16"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter>

            <Style Selector="^.size-xs">
                <Setter Property="Width" Value="12"/>
                <Setter Property="Height" Value="12"/>
            </Style>
            <Style Selector="^.size-sm">
                <Setter Property="Width" Value="14"/>
                <Setter Property="Height" Value="14"/>
            </Style>
            <Style Selector="^.size-md">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
            </Style>
            <Style Selector="^.size-base">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
            </Style>
            <Style Selector="^.size-lg">
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="20"/>
            </Style>
            <Style Selector="^.size-2xl">
                <Setter Property="Width" Value="28"/>
                <Setter Property="Height" Value="28"/>
            </Style>
            <Style Selector="^.size-3xl">
                <Setter Property="Width" Value="48"/>
                <Setter Property="Height" Value="48"/>
            </Style>
            <Style Selector="^.size-4xl">
                <Setter Property="Width" Value="64"/>
                <Setter Property="Height" Value="64"/>
            </Style>

            <Style Selector="^.muted">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            </Style>
            <Style Selector="^.accent">
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            </Style>
            <Style Selector="^.danger">
                <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
            </Style>
            <Style Selector="^.success">
                <Setter Property="Foreground" Value="{DynamicResource Success}"/>
            </Style>

            <Style Selector="^.severity-info">
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            </Style>
            <Style Selector="^.severity-warn">
                <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
            </Style>
            <Style Selector="^.severity-critical">
                <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
            </Style>

        </ControlTheme>

    </Styles.Resources>

</Styles>

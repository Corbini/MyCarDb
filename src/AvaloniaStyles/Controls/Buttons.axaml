<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Variant : filled | bordered | plain | borderless
      Size    : (default 32) | small (24) | large (44)
      Modifier: accent | warn | danger | active
      Shape   : icon (1:1) | pill (fully rounded)
      Special : window-control (+ .close)
    -->

    <Style Selector="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <Style Selector="Button.small">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="Button.large">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.icon.small">
        <Setter Property="Width" Value="24"/>
    </Style>
    <Style Selector="Button.icon.large">
        <Setter Property="Width" Value="44"/>
    </Style>

    <Style Selector="Button.pill">
        <Setter Property="CornerRadius" Value="999"/>
    </Style>

    <Style Selector="Button.filled">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
    </Style>
    <Style Selector="Button.filled:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
        <Setter Property="Opacity" Value="0.92"/>
    </Style>
    <Style Selector="Button.filled:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
        <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <Style Selector="Button.filled.danger">
        <Setter Property="Background" Value="{DynamicResource Danger}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
    </Style>
    <Style Selector="Button.filled.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Danger}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
    </Style>

    <Style Selector="Button.bordered">
        <Setter Property="Background" Value="{DynamicResource BgContent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style Selector="Button.bordered:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgRowHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>

    <Style Selector="Button.bordered.accent">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Button.bordered.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>

    <Style Selector="Button.strong">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.plain">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Button.plain:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgRowHover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>

    <Style Selector="Button.plain.warn">
        <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
    </Style>
    <Style Selector="Button.plain.warn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
    </Style>

    <Style Selector="Button.plain.danger">
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
    </Style>
    <Style Selector="Button.plain.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
    </Style>

    <Style Selector="Button.borderless">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="Button.borderless:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgRowHover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>

    <Style Selector="Button.borderless.selected">
        <Setter Property="Background" Value="{DynamicResource BgRowHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="Button.borderless.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgRowHover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>

    <Style Selector="Button.active">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>

    <Style Selector="Button.window-control">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style Selector="Button.window-control:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgRowHover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style Selector="Button.window-control.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Danger}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
    </Style>

</Styles>

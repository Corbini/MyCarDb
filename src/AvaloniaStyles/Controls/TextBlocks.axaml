<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Variants -->
    <Style Selector="TextBlock.display">
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="-0.72"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>

    <Style Selector="TextBlock.callout">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>

    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>

    <Style Selector="TextBlock.subhead">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
    </Style>

    <Style Selector="TextBlock.section-header">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="0.44"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>

    <Style Selector="TextBlock.eyebrow">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="LetterSpacing" Value="0.66"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
    </Style>

    <Style Selector="TextBlock.kbd-hint">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Opacity" Value="0.75"/>
    </Style>

    <!-- Weight -->
    <Style Selector="TextBlock.strong">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Color -->
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>

    <!-- Preset -->
    <Style Selector="TextBlock.empty">
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
    </Style>

</Styles>

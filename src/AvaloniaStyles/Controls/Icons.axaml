<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Icon">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="Icon">
                <Viewbox Width="{TemplateBinding Width}"
                         Height="{TemplateBinding Height}"
                         Stretch="Uniform">
                    <Canvas Width="256" Height="256">
                        <Path Data="{TemplateBinding Data}"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="16"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"/>
                    </Canvas>
                </Viewbox>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Icon.size-xs">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
    </Style>
    <Style Selector="Icon.size-sm">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
    </Style>
    <Style Selector="Icon.size-md">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    <Style Selector="Icon.size-base">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
    </Style>
    <Style Selector="Icon.size-lg">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
    </Style>
    <Style Selector="Icon.size-2xl">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
    </Style>
    <Style Selector="Icon.size-3xl">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
    </Style>
    <Style Selector="Icon.size-4xl">
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="64"/>
    </Style>

    <Style Selector="Icon.muted">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="Icon.accent">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Icon.danger">
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
    </Style>
    <Style Selector="Icon.success">
        <Setter Property="Foreground" Value="{DynamicResource Success}"/>
    </Style>

    <!-- Severity foreground -->
    <Style Selector="Icon.severity-info">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Icon.severity-warn">
        <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
    </Style>
    <Style Selector="Icon.severity-critical">
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
    </Style>

</Styles>
